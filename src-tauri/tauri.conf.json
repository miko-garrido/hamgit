{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hamgit",
  "version": "0.1.1",
  "identifier": "local.hamgit",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hamgit",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1QjJGNDM5RjZDNDg1RUIKUldUcmhjVDJPZlN5OWRNeElhajBBajdyZ01yZDFDYi9zclordkg4bE0rT3ZpU1QwTjEvNmV6ak8K",
      "endpoints": [
        "https://github.com/miko-garrido/hamgit/releases/latest/download/latest.json"
      ]
    }
  }
}
